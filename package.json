{
  "name": "miss-ticket-pwa",
  "version": "1.0.0",
  "description": "Interface PWA pour Miss Ticket - Contrôle à distance de l'application desktop",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pwa-bundle-budget",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "firebase:rules": "firebase deploy --only firestore:rules",
    "firebase:indexes": "firebase deploy --only firestore:indexes",
    "test:e2e": "playwright test",
    "icons:maskable": "node scripts/generate-maskable.mjs"
  },
  "bundleBudget": {
    "totalGzipKb": 410,
    "_pourquoi": "Relevé de 330 à 410 le 13/09/2026 par firebase 12.14.0 → 12.19.0, un MINEUR qui coûte +55,1 kB gzip (+17,5 %) : mesuré sur deux installations exactes, 315,2 kB avant et 370,3 après, tout dans le chunk principal (1089 → 1287 kB brut). Le coupable est @firebase/firestore 4.15.0 → 4.17.2, qui gagne 288 Kio d ESM là où @firebase/auth n en gagne que 44 ; l app importe firebase/app, firebase/auth et firebase/firestore. 410 rend une marge de ~40 kB, comparable aux ~15 kB qu il y avait sous 330."
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.45.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-qr-reader": "^3.0.0-beta-1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@mister-guiiug/dev-pwa-config": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
