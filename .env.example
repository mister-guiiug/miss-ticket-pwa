# Engendré par `pwa-env sync` depuis config/env.manifest.json.
# App : miss-ticket-pwa
# Ne pas éditer à la main : modifier le manifeste, puis relancer sync --write.

# Firebase API key
VITE_FIREBASE_API_KEY=

# Firebase app id
VITE_FIREBASE_APP_ID=

# Firebase auth domain
VITE_FIREBASE_AUTH_DOMAIN=

# Firebase measurement id
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase messaging sender
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase project id
VITE_FIREBASE_PROJECT_ID=

# Firebase storage bucket
VITE_FIREBASE_STORAGE_BUCKET=

# Clé projet PostHog (nuage EU)
# Repli : absent : pas de mesure ni bandeau
VITE_POSTHOG_KEY=

# DSN Sentry
# Repli : absent : no-op
VITE_SENTRY_DSN=
