rules_version = '2';

// RÈGLES FIRESTORE DU PROJET `miss-ticket`.
//
// CE FICHIER EST LA SEULE SOURCE, ET IL PART EN PRODUCTION À CHAQUE FUSION SUR
// `main` : `deploy.yml` le publie sur le projet (job `deploy-firebase` du
// réutilisable du parc). miss-ticket en gardait une copie et un second workflow,
// jamais abouti ; tous deux sont retirés depuis le 01/10/2026, pour qu'un seul
// chemin publie. Les règles changent avec le code de la PWA qui doit les
// respecter, dans la même PR.
//
// QUI PASSE PAR CES RÈGLES : la PWA seule, en connexion anonyme, par le SDK
// client. Le desktop, tant qu'il écrivait dans Firestore (jusqu'au 21/05/2026),
// s'authentifiait avec un compte de service Google, que les règles ne voient
// pas. Les `if true` posés « pour le Desktop » ne lui ont donc jamais servi :
// ils ouvraient `commands`, `sessions` et `pairing_tokens` à n'importe qui,
// connecté ou non. Retirés le 30/09/2026 : ce que la PWA ne fait pas est refusé.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Le poste appartient-il à l'appelant ? `userId` est le champ que la PWA
    // écrit à l'appariement (le desktop, lui, écrivait `user_id`).
    function ownsDesktop(desktopId) {
      let path = /databases/$(database)/documents/desktops/$(desktopId);
      return signedIn()
        && exists(path)
        && get(path).data.get('userId', null) == request.auth.uid;
    }

    // Un jeton sans échéance passe, comme la PWA le laisse passer. Une échéance
    // qui n'est pas un horodatage est refusée : la PWA lève déjà dessus
    // (`toDate()`).
    function notExpired(token) {
      return token.get('expiresAt', null) == null
        || (token.expiresAt is timestamp && request.time < token.expiresAt);
    }

    // Le jeton que cite le poste passe, DANS CE LOT, de `pending` à `paired` au
    // nom de l'appelant, et il a été émis pour CE poste. C'est ce qui fait de
    // l'appariement la seule façon de prendre un poste.
    function claimsWithPairingToken(desktopId) {
      let token = request.resource.data.get('pairingToken', null);
      let path = /databases/$(database)/documents/pairing_tokens/$(token);
      return token is string
        && exists(path)
        && get(path).data.status == 'pending'
        && get(path).data.desktopId == desktopId
        && getAfter(path).data.status == 'paired'
        && getAfter(path).data.pairedBy == request.auth.uid;
    }

    // Les commandes que la PWA envoie, avec leur charge EXACTE.
    //
    // `launch_session` n'y figure pas : elle transportait l'e-mail ET le mot de
    // passe du compte de billetterie, en clair, dans un document de `commands`
    // que tout le monde pouvait lire. Un mot de passe ne transite jamais par
    // Firestore. Un lancement à distance devra laisser les identifiants sur le
    // desktop, et n'entrera ici qu'avec une charge qui n'en porte aucun.
    function validCommand(action, payload) {
      return payload is map
        && ((action == 'stop_session'
              && payload.keys().hasOnly(['instance_id'])
              && payload.instance_id is string)
          || (action in ['stop_all', 'get_state']
              && payload.keys().size() == 0));
    }

    // ============================================
    // COLLECTION: users
    // ============================================
    match /users/{userId} {
      // Son propre profil, et lui seul.
      allow read, write: if isUser(userId);
    }

    // ============================================
    // COLLECTION: desktops
    // ============================================
    match /desktops/{desktopId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      // Le propriétaire entretient SON poste, sans pouvoir le donner à un autre
      // compte.
      allow update: if signedIn()
        && resource.data.get('userId', null) == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      // Prendre un poste, qu'on le crée ou qu'on le reprenne, ne se fait que
      // dans le lot qui consomme son jeton d'appariement. Avant le 30/09/2026, la
      // mise à jour ne regardait que la valeur ÉCRITE : n'importe quel compte
      // s'attribuait n'importe quel poste en y posant son propre `userId`.
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && claimsWithPairingToken(desktopId);

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ============================================
    // COLLECTION: commands
    // ============================================
    match /commands/{commandId} {
      // Une commande connue, pour SON poste, à son nom, datée par le serveur.
      allow create: if isUser(request.resource.data.userId)
        && ownsDesktop(request.resource.data.desktopId)
        && request.resource.data.keys().hasOnly(
             ['desktopId', 'userId', 'action', 'payload', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && validCommand(request.resource.data.action, request.resource.data.payload);

      // Ses propres commandes, et elles seules. Ni modification ni suppression
      // côté client : le desktop les traitait avec son compte de service.
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ============================================
    // COLLECTION: sessions
    // ============================================
    match /sessions/{sessionId} {
      // Les sessions de SES postes.
      allow read: if signedIn()
        && get(/databases/$(database)/documents/desktops/$(resource.data.desktopId)).data.userId == request.auth.uid;

      // Aucune écriture côté client : seul le desktop publie ses sessions, et
      // elles portent l'e-mail du compte de billetterie.
    }

    // ============================================
    // COLLECTION: pairing_tokens
    // ============================================
    match /pairing_tokens/{tokenId} {
      // Lire UN jeton dont on tient l'identifiant, celui du QR code, qui EST le
      // secret de l'appariement. Jamais les énumérer (pas de `list`) : avant le
      // 30/09/2026, n'importe qui listait les jetons en attente et prenait les
      // postes qui allaient avec. Un jeton consommé ne se relit que par celui
      // qui l'a consommé. Un jeton inconnu se lit « absent », pour que la PWA
      // puisse répondre « Code invalide ».
      allow get: if signedIn()
        && (resource == null
          || resource.data.status == 'pending'
          || resource.data.get('pairedBy', null) == request.auth.uid);

      // Consommer un jeton : `pending` → `paired`, à son propre nom, avant
      // l'échéance, sans toucher au reste, et dans le lot qui prend le poste.
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && notExpired(resource.data)
        && request.resource.data.status == 'paired'
        && request.resource.data.pairedBy == request.auth.uid
        && request.resource.data.pairedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'pairedBy', 'pairedAt'])
        && getAfter(/databases/$(database)/documents/desktops/$(resource.data.desktopId)).data.userId == request.auth.uid;

      // Ni création ni suppression côté client : le desktop émet et nettoie ses
      // jetons avec son compte de service.
    }
  }
}
